<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- base glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#142033"
                android:endColor="#0B1422"/>
            <stroke android:width="1dp" android:color="#263F79FF"/>
        </shape>
    </item>

    <!-- subtle top highlight -->
    <item android:height="22dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#22B5D3FF"
                android:centerColor="#11000000"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
