<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- glass base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"/>
            <gradient
                android:startColor="#0C1018"
                android:endColor="#080D14"
                android:angle="270"/>
            <stroke android:width="1dp" android:color="#203C5CFF"/>
        </shape>
    </item>

    <!-- subtle inner glow near top -->
    <item android:height="18dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#22BBD6FF"
                android:centerColor="#11000000"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
