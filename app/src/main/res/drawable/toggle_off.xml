<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Track -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient
                android:type="linear"
                android:startColor="#122033"
                android:endColor="#0B1526"
                android:angle="270"/>
        </shape>
    </item>

    <!-- Subtle top gloss -->
    <item android:top="1dp" android:bottom="22dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient
                android:type="linear"
                android:startColor="@color/transparent_white_20"
                android:endColor="#00000000"
                android:angle="270"/>
        </shape>
    </item>

    <!-- Knob (top) -->
    <item
        android:gravity="top|center_horizontal"
        android:top="3dp" android:bottom="0dp">
        <shape android:shape="oval">
            <size android:width="24dp" android:height="24dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="16dp"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#6AAEFF"
                android:endColor="#2B65C9"/>
            <stroke android:width="1dp" android:color="#22000000"/>
        </shape>
    </item>

</layer-list>
