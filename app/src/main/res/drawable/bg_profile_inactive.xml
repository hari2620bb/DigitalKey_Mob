<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="36dp"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#1A8FC2FF"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Ring -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#8FC2FF"/>
        </shape>
    </item>

    <!-- Inner dark glass (optional) -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#141B26"
                android:endColor="#0B121C"/>
        </shape>
    </item>
</layer-list>
