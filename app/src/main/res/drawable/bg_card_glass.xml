<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1F1B2B44"
                android:endColor="#19192744"/>
            <stroke android:width="1dp" android:color="#33A3C3FF"/>
        </shape>
    </item>
</layer-list>
