<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <size android:width="56dp" android:height="56dp" />
            <solid android:color="#3300FF47" />
        </shape>
    </item>

    <!-- Inner solid circle -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#1A1F36" />
            <stroke
                android:width="1dp"
                android:color="#5500FF47" />
        </shape>
    </item>

</layer-list>
