<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Track (on gradient) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient
                android:type="linear"
                android:startColor="#0AA8FF"
                android:endColor="#0B4FFF"
                android:angle="270"/>
        </shape>
    </item>

    <!-- Inner glow -->
    <item android:left="2dp" android:right="2dp" android:top="14dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:type="linear"
                android:startColor="#2200FFFF"
                android:endColor="#00000000"
                android:angle="270"/>
        </shape>
    </item>

    <!-- Knob (bottom) -->
    <item
        android:gravity="bottom|center_horizontal"
        android:bottom="3dp">
        <shape android:shape="oval">
            <size android:width="24dp" android:height="24dp"/>
            <solid android:color="#0E1A2C"/>
            <stroke android:width="1dp" android:color="#33000000"/>
        </shape>
    </item>

</layer-list>
