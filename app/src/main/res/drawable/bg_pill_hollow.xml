<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp"/>
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#40B9D1FF"/>
        </shape>
    </item>

    <!-- inner shadow ring -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.5" android:centerY="0.6"
                android:startColor="#14000000"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
