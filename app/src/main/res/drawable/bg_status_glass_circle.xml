<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- outer glow -->
    <item>
        <shape android:shape="oval">
            <size android:width="64dp" android:height="64dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="36dp"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#142C8AFF"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- inner dark glass -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#101720"
                android:endColor="#0B111A"/>
            <stroke android:width="1dp" android:color="#338FB9FF"/>
        </shape>
    </item>
</layer-list>
