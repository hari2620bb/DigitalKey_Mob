<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B294B"
    tools:context=".PairingActivity">

    <!-- Scrollable content (stops above bottom bar) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <!-- Single direct child must be wrap_content to allow scrolling -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerLayout"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvVehicleName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPT Flight"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvVin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5UWXWX7C5EA123456"
                    android:textColor="#BFD0F0"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@id/tvVehicleName"
                    app:layout_constraintTop_toBottomOf="@id/tvVehicleName" />

                <FrameLayout
                    android:id="@+id/ivNotification"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_outline_circle"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell_white"
                        android:contentDescription="@string/notify" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Curved white sheet backdrop -->
            <View
                android:id="@+id/topCurve"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_top_curve"
                app:layout_constraintTop_toBottomOf="@id/headerLayout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Vehicle card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVehicle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="-40dp"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/headerLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/btnManageDigitalKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_white"
                        android:elevation="8dp"
                        android:paddingStart="22dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="12dp"
                        android:text="Manage Digital Key"
                        android:textColor="#446FBC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/ivVehicle"
                        android:layout_width="0dp"
                        android:layout_height="220dp"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/vehicle"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_truck"
                        app:layout_constraintTop_toBottomOf="@id/btnManageDigitalKey"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvVehicleModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="SPT Flight 2024"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/ivVehicle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/ivEditVehicle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_outline_circle"
                        android:contentDescription="@string/edit"
                        android:padding="6dp"
                        android:src="@drawable/ic_edit"
                        android:tint="#446FBC"
                        app:layout_constraintTop_toTopOf="@id/tvVehicleModel"
                        app:layout_constraintBottom_toBottomOf="@id/tvVehicleModel"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- OTP -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOtp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/cardVehicle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOtpHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter 6 digits"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:weightSum="6"
                        android:baselineAligned="false">

                        <!-- 6 OTP boxes -->
                        <EditText
                            android:id="@+id/etOtp1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp2"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp3"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp4"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp5"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp6"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmOtp"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Confirm"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#2F5EAA"
                        app:cornerRadius="22dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed bottom nav (not part of scroll) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:gravity="center"
        android:weightSum="4"
        android:background="@android:color/white"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:tint="#4169E1"
            android:contentDescription="@string/home" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_connect"
            android:tint="#C1C7D0"
            android:contentDescription="@string/connect" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_key"
            android:tint="#C1C7D0"
            android:contentDescription="@string/keys" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:tint="#C1C7D0"
            android:contentDescription="@string/profile" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
