<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_top"
    >

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shareLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi, "
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textStyle="bold"
                    android:textColor="#4DA3FF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_bell"
                    android:layout_marginEnd="12dp"
                    android:tint="@color/white"
                    tools:ignore="UseAppTint" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/white"
                    tools:ignore="UseAppTint" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvShareTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="24sp"
                app:layout_constraintTop_toBottomOf="@id/layoutHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="20dp" />

            <!-- Share Digital Key Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardShareKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/tvShareTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Glass card surface lives inside, so CardView stays transparent -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_round"
                    android:padding="20dp">

                    <!-- scooter overlapping corner -->
                    <ImageView
                        android:id="@+id/imgScooterTiny"
                        android:layout_width="88dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_scooter_side_view"
                        android:scaleType="fitCenter"
                        android:scaleX="-1"
                        android:translationY="-8dp"
                        android:translationX="-28dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- centered title -->
                    <TextView
                        android:id="@+id/tvCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share Digital Key"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:paddingTop="4dp" />

                    <!-- thin divider under title (subtle gradient) -->
                    <View
                        android:id="@+id/titleDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card_divider"
                        app:layout_constraintTop_toBottomOf="@id/tvCardTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- subtitle -->
                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Send a digital key to a friend to share vehicle access"
                        android:textColor="#9CFFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/titleDivider"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Friend name field with small end label -->
                    <FrameLayout
                        android:id="@+id/fieldName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFriendName"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundMode="none">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFriendName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter Friend's Name"
                                android:textColor="@android:color/white"
                                android:textColorHint="#9CFFFFFF"
                                android:background="@null"
                                android:paddingBottom="8dp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- underline -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_input_underline"/>

                        <!-- small right floating label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Friend’s Name"
                            android:textSize="11sp"
                            android:textColor="#B0C7FF"
                            android:layout_gravity="end|top" />
                    </FrameLayout>

                    <!-- Email field -->
                    <FrameLayout
                        android:id="@+id/fieldEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/fieldName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Email input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFriendEmail"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundMode="none"
                            android:hint="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFriendEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter Friend's Email"
                                android:inputType="textEmailAddress"
                                android:importantForAutofill="yes"
                                android:autofillHints="emailAddress"
                                android:textColor="@android:color/white"
                                android:textColorHint="#9CFFFFFF"
                                android:background="@null"
                                android:paddingBottom="8dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- underline -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_input_underline" />

                        <!-- small right floating label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Firend's Email"
                            android:textSize="11sp"
                            android:textColor="#B0C7FF"
                            android:layout_gravity="end|top"
                            android:paddingTop="2dp"
                            android:paddingEnd="2dp" />
                    </FrameLayout>


                    <!-- hollow pill button -->
                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="#D9FFFFFF"
                        android:background="@drawable/bg_pill_hollow"
                        android:layout_marginTop="18dp"
                        app:layout_constraintTop_toBottomOf="@id/fieldEmail"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Permissions Card -->
            <!-- PERMISSIONS CARD (replace your block with this) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPermissions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/cardShareKey"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_round"
                    android:padding="20dp">

                    <!-- scooter overlapping top-right -->
                    <ImageView
                        android:id="@+id/imgScooterPerm"
                        android:layout_width="78dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_scooter_side_view"
                        android:scaleType="fitCenter"
                        android:translationY="-5dp"
                        android:translationX="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- centered title -->
                    <TextView
                        android:id="@+id/tvPermTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permissions"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- thin divider -->
                    <View
                        android:id="@+id/permTitleDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card_divider"
                        app:layout_constraintTop_toBottomOf="@id/tvPermTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- subtitle -->
                    <TextView
                        android:id="@+id/tvPermSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Give permission to a friend to share vehicle access"
                        android:textColor="#9CFFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/permTitleDivider"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- friends row -->
                    <LinearLayout
                        android:id="@+id/layoutFriends"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@id/tvPermSub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- active -->
                        <LinearLayout
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="14dp"
                            android:layout_height="20dp"
                            android:layout_width="20dp">
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/profile_doe"
                                android:background="@drawable/bg_profile_active"
                                android:padding="4dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Doe"
                                android:textColor="#6BFF3C"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="14dp"
                            android:layout_height="20dp"
                            android:layout_width="20dp">
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/profile_wilson"
                                android:background="@drawable/bg_profile_inactive"
                                android:padding="4dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wilson"
                                android:textColor="#9CFFFFFF"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_height="20dp"
                            android:layout_width="20dp">
                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/profile_jane"
                                android:background="@drawable/bg_profile_inactive"
                                android:padding="4dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jane Smith"
                                android:textColor="#9CFFFFFF"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- section divider -->
                    <View
                        android:id="@+id/permDivider1"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_row_divider"
                        app:layout_constraintTop_toBottomOf="@id/layoutFriends"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- row: Unlock/Lock Doors -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowDoors"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp"
                        app:layout_constraintTop_toBottomOf="@id/permDivider1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvDoors"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Unlock/Lock Doors"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/swDoors"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <Switch
                            android:id="@+id/swDoors"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#6BFF3C"
                            android:trackTint="#3344FF33"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvDoors"
                            app:layout_constraintBottom_toBottomOf="@id/tvDoors"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- row divider -->
                    <View
                        android:id="@+id/permDivider2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_row_divider"
                        app:layout_constraintTop_toBottomOf="@id/rowDoors"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- row: Start Engine -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowEngine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp"
                        app:layout_constraintTop_toBottomOf="@id/permDivider2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvEngine"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Start Engine"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/swEngine"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <Switch
                            android:id="@+id/swEngine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#6BFF3C"
                            android:trackTint="#3344FF33"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/tvEngine"
                            app:layout_constraintBottom_toBottomOf="@id/tvEngine"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- footer (Active | Revoke Key) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/rowEngine"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textColor="#6BFF3C"
                            android:textSize="16sp"
                            android:layout_marginEnd="18dp"/>

                        <!-- vertical divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_row_divider"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Revoke Key"
                            android:textColor="#FF5A5A"
                            android:textSize="16sp"
                            android:layout_marginStart="18dp"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bnv_color_selector"
        app:itemTextColor="@color/bnv_color_selector"
        app:itemRippleColor="@color/bnv_ripple_selector"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
