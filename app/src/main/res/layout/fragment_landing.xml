<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_top"
    tools:context=".ui.LandingFragment">

    <!-- MAIN SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp">

            <!-- GREETING -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, "
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@color/blue_200"
                android:textStyle="bold"
                android:textSize="22sp"
                app:layout_constraintStart_toEndOf="@id/tvGreeting"
                app:layout_constraintBaseline_toBaselineOf="@id/tvGreeting"/>

            <!-- HEADER ICONS -->
            <LinearLayout
                android:id="@+id/layoutHeaderIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBaseline_toBaselineOf="@id/tvGreeting">

                <ImageView
                    android:id="@+id/ivNotifications"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_bell"
                    android:tint="@android:color/white"/>

                <ImageView
                    android:id="@+id/ivSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@android:color/white"/>
            </LinearLayout>

            <!-- ENGINE TEMPERATURE -->
            <LinearLayout
                android:id="@+id/layoutTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_temp"
                    android:tint="@android:color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Engine Temperature 56%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/tempProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progress="56"
                android:progressTint="#FFA500"
                android:backgroundTint="#33FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/layoutTemp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- VEHICLE CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVehicle"
                android:layout_width="403dp"
                android:layout_height="505dp"
                android:layout_marginTop="15dp"
                android:elevation="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tempProgress">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vehicle_card"
                    android:padding="6dp">

                    <!-- VEHICLE TITLE ROW -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutVehicleHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- My Dem450 -->
                        <TextView
                            android:id="@+id/tvVehicleName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Dem450"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Refresh Icon -->
                        <ImageView
                            android:id="@+id/ivRefresh"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_refresh_green"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <!-- VIN + Last Synced -->
                    <LinearLayout
                        android:id="@+id/layoutVehicleDetails"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutVehicleHeader">

                        <!-- VIN -->
                        <TextView
                            android:id="@+id/tvVin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5UXWX7C5EA123456"
                            android:textColor="#7FB2FF"
                            android:textSize="14sp" />

                        <!-- Divider -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  |  "
                            android:textColor="#4DFFFFFF"
                            android:textSize="14sp" />

                        <!-- Last Synced -->
                        <TextView
                            android:id="@+id/tvLastSynced"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last synced 01 min ago"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>


                    <!-- BOTTOM LINE -->
                    <View
                        android:id="@+id/vehicleHeaderDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="#26FFFFFF"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutVehicleDetails" />


                    <!-- STATUS CHIPS (BT / UWB ONLY) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutConnections"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/vehicleHeaderDivider">

                        <!-- LEFT: Bluetooth -->
                        <include
                            android:id="@+id/itemBt"
                            layout="@layout/view_status_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- RIGHT: UWB -->
                        <include
                            android:id="@+id/itemEdit"
                            layout="@layout/view_status_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- BATTERY + SCOOTER + CHARGE BTN -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutBattery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutConnections">

                        <!-- LEFT: Battery widget -->
                        <LinearLayout
                            android:id="@+id/layoutBatteryWidget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <View
                                android:layout_width="36dp"
                                android:layout_height="10dp"
                                android:layout_marginBottom="2dp"
                                android:background="@drawable/bg_battery_cap" />

                            <LinearLayout
                                android:layout_width="100dp"
                                android:layout_height="150dp"
                                android:background="@drawable/bg_battery_shell"
                                android:gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:layout_marginTop="50dp"
                                    android:background="@drawable/bg_battery_charge"
                                    android:elevation="4dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Battery"
                                        android:textColor="@android:color/white"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="43"
                                        android:textColor="@android:color/white"
                                        android:textSize="28sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="km Left"
                                        android:textColor="@android:color/white"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="1hr 09min"
                                android:textColor="#E0E0E0"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="for Full Charge Estimate"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>


                        <!-- RIGHT: Scooter image -->
                        <ImageView
                            android:id="@+id/imgScooter"
                            android:layout_width="250dp"
                            android:layout_height="280dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_scooter_side_view"
                            app:layout_constraintBottom_toTopOf="@id/btnChargeNow"
                            app:layout_constraintDimensionRatio="H,16:9"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/layoutBatteryWidget"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!-- FLOATING CHARGE PILL (over card bottom) -->
            <LinearLayout
                android:id="@+id/btnChargeNow"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:elevation="10dp"
                android:translationY="-35dp"
                android:layout_marginLeft="160dp"
                app:layout_constraintTop_toBottomOf="@id/cardVehicle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lightning"
                  />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Charge Now"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ENGINE / BIKE TILES -->
            <LinearLayout
                android:id="@+id/layoutControls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintTop_toBottomOf="@id/cardVehicle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ENGINE -->
                <LinearLayout
                    android:id="@+id/btnEngine"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvEngineTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENGINE"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvEngineSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:alpha="0.9"/>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/toggleEngine"
                        android:layout_width="32dp"
                        android:layout_height="64dp"
                        android:padding="0dp"
                        android:button="@null"
                        android:background="@drawable/toggle_vertical_selector"
                        android:focusable="false"
                        android:contentDescription="Engine Start toggle"/>
                </LinearLayout>

                <!-- BIKE -->
                <LinearLayout
                    android:id="@+id/btnBike"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvBikeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STEERING"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvBikeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unlock"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:alpha="0.9"/>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/toggleBike"
                        android:layout_width="32dp"
                        android:layout_height="64dp"
                        android:padding="0dp"
                        android:button="@null"
                        android:background="@drawable/toggle_vertical_selector"
                        android:focusable="false"
                        android:contentDescription="Bike Unlock toggle"/>
                </LinearLayout>
            </LinearLayout>


            <!-- BOTTOM PRIMARY BUTTONS -->
            <LinearLayout
                android:id="@+id/layoutBottomBtns"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/layoutControls"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btnPairing"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="PAIRING &amp;\nBONDING"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_button_rounded"/>

                <Button
                    android:id="@+id/btnManageKey"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="MANAGE\nDIGITAL KEY"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_button_rounded"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CHILD CONTAINER (if you use it later) -->
    <FrameLayout
        android:id="@+id/landing_child_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <!-- FIXED BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/menu_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bnv_color_selector"
        app:itemTextColor="@color/bnv_color_selector"
        app:itemRippleColor="@color/bnv_ripple_selector"/>

</androidx.constraintlayout.widget.ConstraintLayout>
