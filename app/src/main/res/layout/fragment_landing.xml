<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_top"
    tools:context=".ui.LandingFragment">

    <!-- SCROLLABLE AREA -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Keep a ConstraintLayout inside so your existing constraints still work -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Header Section -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, "
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@color/blue_200"
                android:textStyle="bold"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/tvGreeting"
                app:layout_constraintBaseline_toBaselineOf="@id/tvGreeting" />

            <!-- Notification + Settings icons -->
            <LinearLayout
                android:id="@+id/c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_bell"
                    android:padding="4dp"
                    android:tint="@android:color/white" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_settings"
                    android:padding="4dp"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <!-- Engine Temperature -->
            <LinearLayout
                android:id="@+id/layoutTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_temp"
                    android:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Engine Temperature 56%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/tempProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:progress="56"
                android:progressTint="#FFA500"
                android:backgroundTint="#33FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/layoutTemp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

            <!-- VEHICLE CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVehicle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="24dp"
                app:cardPreventCornerOverlap="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tempProgress"
                android:elevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vehicle_card"
                    android:padding="16dp">

                    <!-- Vehicle Info -->
                    <TextView
                        android:id="@+id/tvVehicleName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Dem450"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvVehicleDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5UXWX7C5EA123456 | Last synced 1 min ago"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvVehicleName" />

                    <!-- Connection Status -->
                    <LinearLayout
                        android:id="@+id/layoutConnections"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:showDividers="middle"
                        android:dividerPadding="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvVehicleDetails"
                        android:layout_marginTop="16dp">

                        <include
                            android:id="@+id/itemBt"
                            layout="@layout/view_status_chip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/itemUwb"
                            layout="@layout/view_status_chip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/itemEdit"
                            layout="@layout/view_status_chip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- Battery & Scooter -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutBattery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutConnections">

                        <!-- Battery capsule -->
                        <LinearLayout
                            android:id="@+id/layoutBatteryWidget"
                            android:layout_width="100dp"
                            android:layout_height="250dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            tools:ignore="MissingConstraints">

                            <!-- Top cap -->
                            <View
                                android:layout_width="36dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_battery_cap"
                                android:layout_marginBottom="4dp"/>

                            <!-- Battery body -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_battery_shell">

                                <!-- Charge indicator -->
                                <LinearLayout
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:layout_marginTop="50dp"
                                    android:orientation="vertical"
                                    android:paddingVertical="10dp"
                                    android:paddingHorizontal="8dp"
                                    android:elevation="4dp"
                                    android:translationZ="2dp"
                                    android:gravity="center"
                                    android:background="@drawable/bg_battery_charge">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Battery"
                                        android:textColor="@android:color/white"
                                        android:textSize="10sp"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="43"
                                        android:textStyle="bold"
                                        android:textColor="@android:color/white"
                                        android:textSize="28sp"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="km Left"
                                        android:textColor="@android:color/white"
                                        android:textSize="12sp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Estimate text -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1hr 09min"
                                android:textStyle="bold"
                                android:textColor="#E0E0E0"
                                android:textSize="14sp"
                                android:layout_marginTop="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="12dp"
                                android:text="for Full Charge Estimate"
                                android:textColor="#80FFFFFF"
                                android:textSize="10sp"/>
                        </LinearLayout>

                        <!-- Scooter -->
                        <ImageView
                            android:id="@+id/imgScooter"
                            android:layout_width="451dp"
                            android:layout_height="287dp"
                            android:layout_marginStart="15dp"
                            android:elevation="20dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_scooter_side_view"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/layoutBatteryWidget"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Charge pill -->
                        <Button
                            android:id="@+id/btnChargeNow"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="-10dp"
                            android:text="⚡  Charge Now"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:background="@drawable/bg_pill_button"
                            android:paddingHorizontal="18dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/imgScooter"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Control Buttons -->
            <LinearLayout
                android:id="@+id/layoutControls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/cardVehicle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="8dp">

                <!-- ENGINE tile -->
                <LinearLayout
                    android:id="@+id/btnEngine"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvEngineTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENGINE"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:textColor="@android:color/white"/>

                        <TextView
                            android:id="@+id/tvEngineSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.9"/>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/toggleEngine"
                        android:layout_width="28dp"
                        android:layout_height="58dp"
                        android:button="@null"
                        android:background="@drawable/toggle_vertical_selector"
                        android:contentDescription="Engine Start toggle"
                        android:focusable="false"/>
                </LinearLayout>

                <!-- BIKE tile -->
                <LinearLayout
                    android:id="@+id/btnBike"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvBikeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BIKE"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:textColor="@android:color/white"/>

                        <TextView
                            android:id="@+id/tvBikeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unlock"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.9"/>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/toggleBike"
                        android:layout_width="28dp"
                        android:layout_height="58dp"
                        android:button="@null"
                        android:background="@drawable/toggle_vertical_selector"
                        android:contentDescription="Bike Unlock toggle"
                        android:focusable="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Buttons -->
            <LinearLayout
                android:id="@+id/layoutBottomBtns"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/layoutControls"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnPairing"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="64dp"
                    android:text="PAIRING &amp;\nBONDING"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:backgroundTint="#3C82FF"
                    android:background="@drawable/bg_button_rounded"/>

                <Button
                    android:id="@+id/btnManageKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:text="MANAGE\nDIGITAL KEY"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:backgroundTint="#3C82FF"
                    android:background="@drawable/bg_button_rounded"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/landing_child_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutBottomBtns"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        tools:ignore="MissingConstraints,NotSibling" />


    <!-- FIXED BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/menu_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bnv_color_selector"
        app:itemTextColor="@color/bnv_color_selector"
        app:itemRippleColor="@color/bnv_ripple_selector"/>
</androidx.constraintlayout.widget.ConstraintLayout>
