<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_top"
    >

    <!-- MAIN SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp">

            <!-- GREETING -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, "
                android:textColor="@android:color/white"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@color/blue_200"
                android:textStyle="bold"
                android:textSize="22sp"
                app:layout_constraintStart_toEndOf="@id/tvGreeting"
                app:layout_constraintBaseline_toBaselineOf="@id/tvGreeting"/>

            <!-- HEADER ICONS -->
            <LinearLayout
                android:id="@+id/layoutHeaderIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBaseline_toBaselineOf="@id/tvGreeting">

                <ImageView
                    android:id="@+id/ivNotifications"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_bell"
                    android:tint="@android:color/white"/>

                <ImageView
                    android:id="@+id/ivSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@android:color/white"/>
            </LinearLayout>

            <!-- ENGINE TEMPERATURE -->
            <LinearLayout
                android:id="@+id/layoutTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_temp"
                    android:tint="@android:color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Engine Temperature 56%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/tempProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progress="56"
                android:progressTint="#FFA500"
                android:backgroundTint="#33FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/layoutTemp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- VEHICLE CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVehicle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:elevation="8dp"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="24dp"
                app:cardPreventCornerOverlap="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tempProgress">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vehicle_card"
                    android:padding="20dp">

                    <!-- Header row: title + refresh -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutVehicleHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvVehicleName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Dem450"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <ImageView
                            android:id="@+id/ivRefresh"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_refresh_green"
                            android:tint="#00FF73"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- VIN + Last synced -->
                    <LinearLayout
                        android:id="@+id/layoutVehicleDetails"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@id/layoutVehicleHeader"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvVin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5UXWX7C5EA123456"
                            android:textColor="#7FB2FF"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  |  "
                            android:textColor="#4DFFFFFF"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvLastSynced"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last synced 01 min ago"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#26FFFFFF"
                        app:layout_constraintTop_toBottomOf="@id/layoutVehicleDetails"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Scooter -->
                    <ImageView
                        android:id="@+id/imgScooter"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_scooter_side_view"
                        app:layout_constraintTop_toBottomOf="@id/layoutVehicleDetails"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="H,16:9" />
                    <TextView
                        android:id="@+id/tvVehicleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Searching for Device..."
                        android:textColor="#fff"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/imgScooter"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="44dp"/>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvVehicleStatus"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        style="?android:attr/progressBarStyleLarge" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- PRIMARY BUTTONS: START + LOGS -->
            <LinearLayout
                android:id="@+id/layoutPrimaryButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/cardVehicle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- START BUTTON -->
                <Button
                    android:id="@+id/btnShareBond"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_primary_button"
                    android:gravity="center"
                    android:text="START PAIRING &amp;\nBONDING"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"/>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>

                <!-- LOGS -->
                <Button
                    android:id="@+id/btnViewLogs"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:text="LOGS"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"/>
            </LinearLayout>


            <!-- Divider under buttons -->
            <View
                android:id="@+id/sectionDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#26FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/layoutPrimaryButtons"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- STATUS LIST -->
            <LinearLayout
                android:id="@+id/layoutStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/sectionDivider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:tint="#00FF73"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Initiating Owner Pairing"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:tint="#00FF73"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Phase 2 completed"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:tint="#00FF73"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Phase 3 completed"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- HMI PASSWORD LABEL -->
            <TextView
                android:id="@+id/tvHmiPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="HMI Password"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/layoutStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- PIN BOXES -->
            <LinearLayout
                android:id="@+id/layoutPinBoxes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvHmiPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/etOtpInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="000000"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="24sp"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:background="@drawable/bg_otp_input"
                    android:letterSpacing="0.3"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

            <!-- CONFIRM BUTTON -->
            <Button
                android:id="@+id/btnSubmitOtp"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:text="Confirm"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:background="@drawable/bg_button_rounded"
                app:layout_constraintTop_toBottomOf="@id/layoutPinBoxes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/menu_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bnv_color_selector"
        app:itemTextColor="@color/bnv_color_selector"
        app:itemRippleColor="@color/bnv_ripple_selector" />

</androidx.constraintlayout.widget.ConstraintLayout>
