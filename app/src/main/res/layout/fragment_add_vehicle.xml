<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_vehicle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_top"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:paddingTop="100dp"
        android:paddingBottom="40dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_add_vehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Vehicle"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- VIN Input -->
        <EditText
            android:id="@+id/et_vin"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:hint="Enter your VIN"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="17"
            android:drawableStart="@drawable/ic_vehicle"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:background="@drawable/edittext_background"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tv_add_vehicle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_vin"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/blue"
            app:cornerRadius="28dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/et_vin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>


        <!-- OR Divider -->
        <LinearLayout
            android:id="@+id/divider_or"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btn_submit_vin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#66FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR"
                android:layout_marginHorizontal="8dp"
                android:textSize="14sp"
                android:textColor="#B3FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#66FFFFFF" />
        </LinearLayout>

        <!-- Scan VIN Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_vin"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Scan your VIN"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            app:backgroundTint="#3B82F6"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/divider_or"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Info Text -->
        <TextView
            android:id="@+id/tv_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="If the application is used for managing vehicles, scanning the VIN should be the first step when adding a new vehicle to the inventory"
            android:textAlignment="center"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/btn_scan_vin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
