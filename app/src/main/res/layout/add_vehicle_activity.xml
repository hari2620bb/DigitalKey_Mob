<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_vehicle_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#1B294B">

    <!-- Curved white backdrop -->
    <View
        android:id="@+id/top_curve_sheet"
        android:layout_width="1546dp"
        android:layout_height="1546dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="110dp"
        android:background="@drawable/bg_top_curve_vector" />

    <!-- Foreground content MUST be wrap_content to allow scrolling -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="140dp"
            android:layout_height="70dp"
            app:srcCompat="@drawable/bb_logo"
            android:tint="#fff"
            android:contentDescription="@string/app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="90dp" />

        <TextView
            android:id="@+id/tv_add_vehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Vehicle"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/blue"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/et_vin"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:hint="Enter your VIN"
            android:inputType="textCapCharacters"
            android:maxLength="17"
            android:drawableStart="@drawable/ic_vehicle"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:background="@drawable/edittext_background"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tv_add_vehicle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="24dp" />

        <!-- Submit button (initially hidden) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_vin"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/blue"
            app:cornerRadius="28dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/et_vin"
            app:layout_constraintStart_toStartOf="@id/btn_scan_vin"
            app:layout_constraintEnd_toEndOf="@id/btn_scan_vin"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>


        <LinearLayout
            android:id="@+id/divider_or"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/btn_submit_vin"
            app:layout_constraintStart_toStartOf="@id/btn_submit_vin"
            app:layout_constraintEnd_toEndOf="@id/btn_submit_vin"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR"
                android:layout_marginHorizontal="8dp"
                android:textSize="14sp"
                android:textColor="@color/gray" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/gray" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_vin"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="Scan your VIN"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/blue"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/divider_or"
            app:layout_constraintStart_toStartOf="@id/et_vin"
            app:layout_constraintEnd_toEndOf="@id/et_vin"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="If the application is used for managing vehicles, scanning the VIN should be the first step when adding a new vehicle to the inventory"
            android:textAlignment="center"
            android:textColor="@color/gray"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/btn_scan_vin"
            app:layout_constraintStart_toStartOf="@id/btn_scan_vin"
            app:layout_constraintEnd_toEndOf="@id/btn_scan_vin" />

        <!-- Bottom spacer so the last item isn't flush with the edge -->
        <Space
            android:layout_width="0dp"
            android:layout_height="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>