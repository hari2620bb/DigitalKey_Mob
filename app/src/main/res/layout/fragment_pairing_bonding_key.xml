<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_top">

    <!-- Scrollable content (stops above bottom bar) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Single direct child must be wrap_content to allow scrolling -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerLayout"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvVehicleName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPT Flight"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvVin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5UWXWX7C5EA123456"
                    android:textColor="#BFD0F0"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@id/tvVehicleName"
                    app:layout_constraintTop_toBottomOf="@id/tvVehicleName" />

                <FrameLayout
                    android:id="@+id/ivNotification"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_outline_circle"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell_white"
                        android:contentDescription="@string/notify" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>



            <!-- Vehicle card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVehicle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-60dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/headerLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vehicle_card"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/ivCenterCircle"
                        android:layout_width="280dp"
                        android:layout_height="250dp"
                        android:contentDescription="Searching device"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_scooter_side_view"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvVehicleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toBottomOf="@id/ivCenterCircle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvVehicleDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehicle Details"
                        android:textColor="#FFF"
                        android:textSize="15sp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvVehicleStatus"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- OTP -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOtp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/cardVehicle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOtpHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter 6 digits"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:weightSum="6"
                        android:baselineAligned="false">

                        <!-- 6 OTP boxes -->
                        <EditText
                            android:id="@+id/etOtp1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp2"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp3"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp4"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp5"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />

                        <EditText
                            android:id="@+id/etOtp6"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="18sp"
                            android:background="@drawable/bg_otp_circle"
                            android:importantForAutofill="no"
                            android:imeOptions="flagNoEnterAction" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmOtp"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Confirm"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#2F5EAA"
                        app:cornerRadius="22dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/bg_bottom_nav"
        app:menu="@menu/menu_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bnv_color_selector"
        app:itemTextColor="@color/bnv_color_selector"
        app:itemRippleColor="@color/bnv_ripple_selector"/>
</androidx.constraintlayout.widget.ConstraintLayout>
